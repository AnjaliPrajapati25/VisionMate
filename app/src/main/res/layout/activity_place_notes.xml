<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Place Notes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#102B50"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save important information about places you know."
            android:textSize="17sp"
            android:textColor="#334155"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnAddPlace"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Add New Place"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D5CA5"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/etSearchPlace"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Search places..."
            android:textSize="17sp"
            android:padding="12dp"
            android:singleLine="true"
            android:inputType="text"
            android:contentDescription="Search saved places"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Places"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#102B50"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/placesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>
