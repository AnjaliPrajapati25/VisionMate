<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VisionMate"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#102B50"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hello! How can I help you today?"
            android:textSize="20sp"
            android:textColor="#334155"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a feature"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#102B50"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnContacts"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="Emergency Contacts"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D5CA5"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnPlaceNotes"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="Personal Place Notes"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D5CA5"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnTasks"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="Daily Tasks"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D5CA5"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="Help and Instructions"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D5CA5"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VisionMate - Accessible, Simple and Offline"
            android:textSize="15sp"
            android:textColor="#475569"
            android:gravity="center"
            android:padding="12dp"/>

    </LinearLayout>

</ScrollView>
